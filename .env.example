# Copy to .env.local and fill in from your Supabase project:
#   Project Settings -> Data API  (URL)
#   Project Settings -> API Keys  (anon / publishable key)
#
# Without these the app falls back to an in-memory store: everything works,
# but nothing survives a refresh and a dev banner says so.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Who can sign in: Name:email pairs, comma separated. The login screen shows
# the names as a picker; each must match a user you created in
# Supabase -> Authentication -> Users. SERVER-ONLY — deliberately not
# NEXT_PUBLIC_, so no address ever ships in the browser bundle.
#   LOGIN_ACCOUNTS=Devansh:you@example.com,Rahul:rahul@example.com
LOGIN_ACCOUNTS=

# The older one-account setting. Still read when LOGIN_ACCOUNTS is empty.
LOGIN_EMAIL=
